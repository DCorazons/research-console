# Copy to .env (not committed) and fill in the passwords and the secret.

# Port of the web interface, on 127.0.0.1 only (open it through an SSH tunnel)
CONSOLE_PORT=9000

# 'view' reads every page and export; 'control' also creates plans and runs the queue.
# Use two different long passwords, for example: openssl rand -base64 24
VIEW_PASSWORD=
CONTROL_PASSWORD=
# Signs the session cookie: openssl rand -hex 32
SECRET_KEY=

# Layout on the VPS (README). CONSOLE_DATA holds the SQLite file of the console.
RESEARCH_ROOT=/opt/research
DATA_DIR=/opt/research/data
RESULTS_DIR=/opt/research/results
K6_DIR=/opt/research/console/k6
CONSOLE_DATA=/opt/research/console-data
CONSOLE_DB=/data/console.db

# Owner of the results folder on the host (id -u):(id -g); k6 writes its summary as it
K6_USER=1000:1000
K6_IMAGE=grafana/k6:1.3.0

# Tags each checkout must be on before a run
TAG_AR=v1-ar
TAG_REPO=v1-repo
TAG_QB=v1-qb

# Table 3.6 and the pilot (load levels 25/50/75 VU, stress from 75 in steps of 50)
WARMUP_S=60
RAMP_S=30
SUSTAIN_S=60
THINK_S=1
LOAD_VUS=25,50,75
STRESS_VUS=75,125,175,225,275

# Validity: invalid when k6 reaches this CPU share of one core, or steal reaches this share
K6_CPU_LIMIT=0.80
STEAL_LIMIT=0.05
MAX_ATTEMPTS=3

INFLUX_URL=http://127.0.0.1:8086
INFLUX_DB=k6
PROMETHEUS_URL=http://127.0.0.1:9090

# Shown times: UTC plus this many hours (7 = WIB)
TZ_OFFSET_HOURS=7
